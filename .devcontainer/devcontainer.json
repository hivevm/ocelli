{
  "name": "Ocelli DevContainer",

  // The base image plus the desktop host's Linux build libraries (ADR-0009).
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // The host's agent config and GitHub CLI login, so a login made on either side holds on both and
  // survives a rebuild. HOME is set on Linux and macOS, USERPROFILE on Windows; exactly one of the
  // two is non-empty, so concatenating both yields the home directory on every host (the pattern
  // the Dev Containers documentation recommends). gh reads its token from this directory only when
  // the host keeps it there, not in the system keyring: log in on the host with
  // `gh auth login --insecure-storage`. On Windows the host's gh keeps its config under %AppData%,
  // so the directory starts empty and holds the container's own login.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/vscode/.config/gh,type=bind"
  ],

  // Runs on the host before the container is created. Ensures the bind-mount sources exist, so
  // Docker neither refuses the mount nor creates them root-owned (which breaks credential writes
  // inside the container). Written to work in both a POSIX shell and cmd.exe: one plain `mkdir`
  // with the parents listed first (cmd.exe knows no `-p`), and `|| exit 0` so an already existing
  // directory — an error for both shells — does not abort the container build.
  "initializeCommand": "mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\" \"${localEnv:HOME}${localEnv:USERPROFILE}/.config\" \"${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh\" || exit 0",

  // Runs inside the container on every start, so the settings are set again should a session
  // have changed them: the repository's git hooks under .githooks/ and the merge settings they
  // rely on. What each refuses, and the same commands for a clone outside the container,
  // are under "Git hooks" in the README.
  "postStartCommand": {
    "hooks": "git config core.hooksPath .githooks",
    "merge": "git config merge.ff false && git config pull.ff only",
    "index": "git config merge.adr-index.driver '.githooks/merge-adr-index %O %A %B %S %X %Y'"
  },

  // Runs inside the container once it is created: the Windows build's lint in
  // scripts/check-build.sh, the target and cargo-xwin, pinned; the MSVC runtime and SDK it fetches
  // on its first run. It runs here, not in the Dockerfile, because the Rust Feature is installed
  // after the Dockerfile's layers.
  "postCreateCommand": "rustup target add x86_64-pc-windows-msvc && cargo install cargo-xwin --locked --version 0.23.1",

  // DevContainer Features layered on top of the base image. The container intentionally has NO
  // access to the host Docker daemon (no socket mount) — see ADR-0009. Manage the host's containers
  // from a host-side VS Code extension instead (README → "Host container management").
  "features": {
    // GitHub CLI (`gh`) — used by the coding agent for GitHub operations and as the git
    // credential helper. A push and every gh action wait for a human instruction
    // (AGENTS.md, section 6).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Rust through rustup; rust-toolchain.toml pins the version and the components (ADR-0007).
    "ghcr.io/devcontainers/features/rust:1": {},
    // Bun, the web interface's package manager and task runner (ADR-0007).
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.4.1"
    }
  },

  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },

  // 1420: the Vite dev server of the web interface (`bun run tauri dev`).
  "forwardPorts": [1420],

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
