{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ocelli",
  "identifier": "org.hivevm.ocelli",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd src-web dev",
    "beforeBuildCommand": "bun run --cwd src-web build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ocelli",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://www.gravatar.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/licenses/OpenSSL-LICENSE.txt": "licenses/OpenSSL-LICENSE.txt"
      }
    }
  }
}
